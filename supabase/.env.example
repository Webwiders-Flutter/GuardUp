# ==============================================================================
# GuardUp - Supabase Edge Function secrets
#
# Copy to supabase/.env (gitignored), fill in values, then apply with:
#   supabase secrets set --env-file ./supabase/.env
#
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
# automatically into deployed Edge Functions. Do NOT set them with
# `supabase secrets set` (the SUPABASE_ prefix is reserved).
# ==============================================================================

# Shared secret that database triggers send (x-internal-secret header) to call
# send-notification, user-lifecycle-events and purge-user-storage. Generate with:
#   openssl rand -hex 32
# Store the SAME value in Vault as 'internal_function_secret' (see bottom).
INTERNAL_FUNCTION_SECRET=

# Firebase service account JSON (single line) used by send-notification
# to send FCM pushes. Firebase Console -> Project settings -> Service accounts
# -> Generate new private key. Without it, send-notification runs in
# simulation mode (logs only, no pushes).
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com"}'

# Email sender for user-lifecycle-events (approved / rejected / deleted emails).
# Must be an address on a domain verified with your email provider.
EMAIL_FROM="GuardUp <no-reply@yourdomain.com>"

# Email provider: set EITHER Resend OR SMTP. If neither is set, emails are
# only logged (simulation mode).
# Option A - Resend (https://resend.com)
RESEND_API_KEY=
# Option B - SMTP (e.g. Gmail app password, Mailgun, SES SMTP)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# ------------------------------------------------------------------------------
# Database (Vault) secret - NOT read from this file.
#
# The notifications and user lifecycle triggers call Edge Functions
# (send-notification, user-lifecycle-events) using the internal secret above.
# Run once in the SQL editor, with the SAME value as INTERNAL_FUNCTION_SECRET:
#
#   select vault.create_secret('<INTERNAL_FUNCTION_SECRET>', 'internal_function_secret');
#   -- optional, defaults to https://xbdxsfnicuelqnsdwire.supabase.co
#   select vault.create_secret('https://<project-ref>.supabase.co', 'supabase_url');
# ------------------------------------------------------------------------------
